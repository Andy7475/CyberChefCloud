{
    "name": "CyberChefCloud",
    "short_name": "CyberChefCloud",
    "description": "CyberChef with Google Cloud operations: encode, decode, analyse and transform data in the browser.",
    "id": "./",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "orientation": "any",
    "background_color": "#ffffff",
    "theme_color": "#3f51b5",
    "icons": [
        {
            "src": "images/cyberchef-128x128.png",
            "sizes": "128x128",
            "type": "image/png"
        },
        {
            "src": "images/cyberchef-256x256.png",
            "sizes": "256x256",
            "type": "image/png"
        },
        {
            "src": "images/cyberchef-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        }
    ],
    "share_target": {
        "action": "./share-target",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "files",
                    "accept": [
                        "image/*",
                        "audio/*",
                        "application/pdf",
                        "text/*"
                    ]
                }
            ]
        }
    }
}
